# Opt-in Vault configuration template. Copy to .env.local for local work.
# Every `replace-me`/`replace-with-...` value is public and intentionally
# invalid or unsafe. Generate a distinct secret for each variable and keep
# .env.local out of source control.

# Application and database ---------------------------------------------------
# The public base URL is used to build HTTPS unsubscribe links during dispatch.
# Dispatch rejects HTTP (including localhost); replace this reserved-domain value.
NEXT_PUBLIC_APP_URL=https://replace-with-public-vault.invalid

# Local libSQL works without a token. Production should use a durable Turso
# libsql:// URL; do not use a local file database on ephemeral/serverless hosts.
TURSO_DATABASE_URL=file:./data/opt-in-vault.db
TURSO_AUTH_TOKEN=

# Tenant API keys and dashboard sessions ------------------------------------
# API key peppers and session secrets must each contain at least 32 bytes.
API_KEY_PEPPER=replace-me
API_KEY_PEPPER_VERSION=1
# Optional historical peppers. Current + historical entries are capped at 8.
# API_KEY_PEPPERS_JSON={"1":"replace-with-the-previous-32-byte-pepper"}

SESSION_SECRET=replace-me

# Bounded cron routes --------------------------------------------------------
# Required for Authorization: Bearer authentication on both cron endpoints.
CRON_SECRET=replace-me

# Dispatch and suppression --------------------------------------------------
# Safety default: this must stay false until the live-send checklist passes.
LIVE_SENDS_ENABLED=false

# Optional CLI batch size; default 25 and allowed range 1..50.
DISPATCH_BATCH_SIZE=25
DISPATCH_LEASE_PEPPER=replace-me
UNSUBSCRIBE_TOKEN_SECRET=replace-me
SUPPRESSION_HASH_KEY=replace-me

# Encrypted SMTP / IMAP / OAuth / local-DKIM credential envelope ------------
# Exactly 32 bytes, encoded as 64 hex characters or canonical base64.
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
CREDENTIAL_ENCRYPTION_KEY_VERSION=1
# Optional historical keys. Current + historical entries are capped at 8 and
# the serialized JSON is capped at 32 KiB.
# CREDENTIAL_ENCRYPTION_KEYS_JSON={"1":"replace-with-the-previous-32-byte-key"}

# Public consent capture ----------------------------------------------------
# The three HMAC/pepper values must each contain at least 32 bytes.
CAPTURE_SITE_KEY_PEPPER=replace-me
CONSENT_SUBJECT_HASH_KEY=replace-me
CONSENT_SIGNATURE_KEY=replace-me
CONSENT_SIGNATURE_KEY_VERSION=1

# Exactly 32 bytes, encoded as 64 hex characters or canonical base64.
CONSENT_ENCRYPTION_KEY=replace-with-64-hex-characters
CONSENT_PAYLOAD_KEY_VERSION=1

# Explicit positive retention duration for newly captured evidence.
CONSENT_RETENTION_DAYS=365

# Optional historical certificate-verification/decryption keys. Each ring is
# capped at 8 entries; each value is capped at 16 KiB.
# CONSENT_SIGNATURE_KEYS_JSON={"1":"replace-with-the-previous-signature-key"}
# CONSENT_ENCRYPTION_KEYS_JSON={"1":"replace-with-the-previous-32-byte-key"}

# Required only when certificate share tokens are provisioned and used.
CERTIFICATE_SHARE_TOKEN_PEPPER=replace-me
