# Public application URL. This value is safe to expose.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local libSQL works without a token. Use a libsql:// URL and a real token only
# in an ignored local environment file when connecting to Turso.
TURSO_DATABASE_URL=file:./data/opt-in-vault.db
TURSO_AUTH_TOKEN=

# Replace every value below in .env.local. Never commit generated secrets.
API_KEY_PEPPER=replace-with-at-least-32-random-bytes
SESSION_SECRET=replace-with-at-least-32-random-bytes
CRON_SECRET=replace-with-at-least-32-random-bytes
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
CONSENT_EVIDENCE_HMAC_KEY=replace-with-at-least-32-random-bytes

# Delivery fails closed unless this is explicitly changed at runtime and all
# campaign, inbox, domain-health, suppression, and quota gates also pass.
LIVE_SENDS_ENABLED=false
